<style>
:root{--bg:#f2f0e9;--paper:#faf9f5;--ink:#18211c;--muted:#737970;--line:#d9d9cf;--dark:#111714;--dark2:#1b2520;--lime:#c7e27b;--rust:#a65d48;--sage:#899780;--serif:'Playfair Display',Georgia,serif;--sans:'DM Sans',sans-serif;--display:'Manrope',sans-serif;--mono:'DM Mono',monospace;--max:1240px}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.65 var(--sans);-webkit-font-smoothing:antialiased;overflow-x:hidden}a{color:inherit;text-decoration:none}button{font:inherit}.container{width:min(var(--max),calc(100% - 64px));margin:auto}.mono{font:10px var(--mono);letter-spacing:.13em;text-transform:uppercase}.muted{color:var(--muted)}
/* Animated portfolio opening */
.loader{position:fixed;inset:0;background:#17372b;z-index:1000;display:grid;place-items:center;color:#f7fbf7;transition:opacity .85s cubic-bezier(.7,0,.2,1),visibility .85s;overflow:hidden}.loader:before,.loader:after{content:"";position:absolute;width:46vw;height:46vw;min-width:360px;min-height:360px;border:1px solid #d7f0df22;border-radius:50%;animation:loaderOrbit 7s linear infinite}.loader:after{width:62vw;height:62vw;min-width:480px;min-height:480px;animation-direction:reverse;opacity:.55}.loader.done{opacity:0;visibility:hidden;pointer-events:none}.loader-inner{width:min(510px,78vw);position:relative;z-index:2}.loader-brand{font:500 11px var(--mono);letter-spacing:.18em;color:#c6e8cf}.loader-headline{font:500 clamp(31px,5.4vw,54px)/1.06 var(--serif);letter-spacing:-.04em;margin:26px 0 10px;min-height:2.2em}.loader-headline em{color:#bde4c7;font-style:italic}.loader-sub{font:10px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:#b4c9b9;min-height:18px}.loader-line{height:3px;background:#ffffff25;margin-top:25px;overflow:hidden;border-radius:4px}.loader-line:after{content:'';display:block;height:100%;width:100%;background:linear-gradient(90deg,#a9dcb8,#effff1);transform:translateX(-100%);animation:load 2.45s cubic-bezier(.7,0,.2,1) forwards}.loader-mark{position:absolute;right:0;top:-4px;width:43px;height:43px;border:1px solid #d8f0df88;border-radius:50%;display:grid;place-items:center;color:#d8f0df;font:500 14px var(--serif);animation:markPop .55s 2.25s cubic-bezier(.2,1.7,.4,1) both}.loader-foot{display:flex;justify-content:space-between;margin-top:14px;color:#a9c3af;font:9px var(--mono);letter-spacing:.1em;text-transform:uppercase}.loader-pulse{display:inline-block;width:6px;height:6px;background:#bde4c7;border-radius:50%;margin-right:8px;animation:pulse 1s infinite}@keyframes load{to{transform:translateX(0)}}@keyframes loaderOrbit{to{transform:rotate(360deg)}}@keyframes markPop{from{opacity:0;transform:scale(.2)}to{opacity:1;transform:scale(1)}}
/* Nav */
.header{position:fixed;z-index:80;top:0;left:0;width:100%;background:rgba(242,240,233,.91);backdrop-filter:blur(18px);border-bottom:1px solid rgba(24,33,28,.12);transition:box-shadow .3s}.header.scrolled{box-shadow:0 8px 30px #18211c0c}.nav{height:76px;display:flex;align-items:center;justify-content:space-between}.brand{display:flex;gap:12px;align-items:center;font:800 14px var(--display);letter-spacing:-.04em}.brand-mark{display:grid;place-items:center;width:31px;height:31px;background:var(--dark);color:var(--lime);font:500 13px var(--serif)}.nav-links{display:flex;align-items:center;gap:27px}.nav-links a{font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#666e66;transition:color .2s}.nav-links a:hover,.nav-links a.active{color:var(--rust)}.nav-right{display:flex;align-items:center;gap:15px}.availability{display:flex;align-items:center;gap:8px;font:10px var(--mono);color:#59645b}.availability:before{content:'';width:6px;height:6px;border-radius:50%;background:#83a65d;box-shadow:0 0 0 4px #83a65d22}.nav-cta{border:1px solid var(--ink);padding:10px 14px;font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;transition:.25s}.nav-cta:hover{background:var(--ink);color:white}.menu{display:none;background:none;border:1px solid var(--line);padding:9px 12px}
/* Hero */
.hero{min-height:780px;padding:150px 0 75px;background:var(--dark);color:#f4f2eb;position:relative;overflow:hidden}.hero:before{content:'';position:absolute;width:720px;height:720px;border:1px solid #ffffff12;border-radius:50%;right:-230px;top:20px;box-shadow:0 0 0 65px #ffffff08,0 0 0 130px #ffffff05}.hero:after{content:'';position:absolute;inset:0;background:linear-gradient(115deg,transparent 50%,#c7e27b09 100%);pointer-events:none}.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:70px;align-items:center;position:relative;z-index:2}.hero-kicker{display:flex;align-items:center;gap:12px;color:var(--lime)}.hero-kicker:before{content:'';width:34px;height:1px;background:var(--lime)}.hero h1{font:500 clamp(54px,7.2vw,96px)/.99 var(--serif);letter-spacing:-.055em;margin:28px 0 25px;max-width:760px}.hero h1 em{color:var(--lime);font-weight:500}.hero-copy{max-width:620px;color:#c2c9c1;font-size:16px;line-height:1.9}.hero-meta{display:flex;gap:22px;flex-wrap:wrap;margin-top:30px;color:#aab3a9;font:10px var(--mono);letter-spacing:.06em;text-transform:uppercase}.hero-actions{display:flex;gap:12px;margin-top:36px;flex-wrap:wrap}.btn{display:inline-flex;align-items:center;gap:13px;padding:14px 18px;background:var(--lime);color:var(--dark);font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;transition:transform .25s,background .25s}.btn:hover{transform:translateY(-3px);background:#d8f39a}.btn.ghost{background:transparent;color:#f4f2eb;border:1px solid #ffffff45}.btn.ghost:hover{background:#ffffff12}
/* Hero data dashboard */
.dashboard{background:#1b2520;border:1px solid #ffffff20;padding:24px;position:relative;box-shadow:0 30px 80px #0005;transform:translateY(14px);animation:dashIn 1s .4s both}.dashboard:before{content:'MARKETING PERFORMANCE / SNAPSHOT';position:absolute;top:-28px;left:0;color:#9ba79a;font:9px var(--mono);letter-spacing:.14em}.dash-top{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #ffffff20;padding-bottom:15px}.dash-top b{font:600 11px var(--mono);letter-spacing:.1em}.live{color:var(--lime);font:9px var(--mono)}.live:before{content:'';display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--lime);margin-right:7px;animation:pulse 1.8s infinite}@keyframes pulse{50%{box-shadow:0 0 0 6px #c7e27b18}}.dash-metrics{display:grid;grid-template-columns:1fr 1fr}.dash-metric{padding:22px 15px 18px 0;border-bottom:1px solid #ffffff19}.dash-metric:nth-child(odd){border-right:1px solid #ffffff19}.dash-metric:nth-child(even){padding-left:20px}.dash-metric:nth-last-child(-n+2){border-bottom:0}.dash-metric strong{display:block;font:700 clamp(30px,3.5vw,43px)/1 var(--display);letter-spacing:-.07em;color:var(--lime)}.dash-metric span{display:block;margin-top:9px;color:#b5beb4;font-size:10px;line-height:1.5}.chart-wrap{margin-top:15px;padding-top:16px;border-top:1px solid #ffffff20}.chart-head{display:flex;justify-content:space-between;color:#aab3a9;font:9px var(--mono);letter-spacing:.1em}.chart{width:100%;height:105px;margin-top:12px;overflow:visible}.chart path.line{stroke:var(--lime);stroke-width:2.5;fill:none;stroke-dasharray:700;stroke-dashoffset:700}.chart path.area{fill:url(#area);opacity:.7}.chart circle{fill:var(--lime);opacity:0}.dashboard.is-live .chart path.line{animation:draw 2.2s .15s cubic-bezier(.2,.7,.2,1) forwards}.dashboard.is-live .chart circle{animation:fadeIn .35s 2.15s forwards}.dashboard.is-live .chart path.area{animation:areaReveal 1.8s .2s ease both}@keyframes areaReveal{from{opacity:0}to{opacity:.7}}@keyframes draw{to{stroke-dashoffset:0}}@keyframes fadeIn{to{opacity:1}}@keyframes dashIn{from{opacity:0;transform:translateY(35px)}to{opacity:1;transform:translateY(0)}}
/* ticker */
.ticker{background:var(--lime);color:var(--dark);overflow:hidden;border-bottom:1px solid #a9c45d}.ticker-track{display:flex;width:max-content;animation:marquee 36s linear infinite}.ticker:hover .ticker-track{animation-play-state:paused}.ticker span{padding:15px 25px;font:10px var(--mono);letter-spacing:.12em;text-transform:uppercase;white-space:nowrap}.ticker span:after{content:'✳';padding-left:50px}@keyframes marquee{to{transform:translateX(-50%)}}
/* General sections */
.section{padding:115px 0;border-bottom:1px solid var(--line);position:relative}.section.dark{background:var(--dark);color:#f4f2eb;border-color:#ffffff18}.section-head{display:grid;grid-template-columns:180px 1fr;gap:55px;margin-bottom:58px}.section-label{color:var(--rust);padding-top:9px}.dark .section-label{color:var(--lime)}.section-title{font:500 clamp(38px,5vw,63px)/1.05 var(--serif);letter-spacing:-.045em;max-width:850px;margin:0}.section-title em{color:var(--rust);font-weight:500}.dark .section-title em{color:var(--lime)}.section-intro{color:var(--muted);max-width:650px;margin:17px 0 0;font-size:14px;line-height:1.85}.dark .section-intro{color:#b2bbb1}
/* About */
.about-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:90px}.about-copy{font-size:16px;line-height:1.95;color:#586158}.about-copy p{margin:0 0 20px}.about-copy strong{color:var(--ink)}.principles{border-top:1px solid var(--line)}.principle{display:grid;grid-template-columns:1fr;gap:14px;padding:19px 0;border-bottom:1px solid var(--line)}.principle h3{font:700 14px var(--display);margin:0 0 6px}.principle p{margin:0;color:var(--muted);font-size:12px;line-height:1.7}
/* Experience */
.timeline{border-top:1px solid var(--line)}.role{display:grid;grid-template-columns:190px 1fr;gap:45px;padding:30px 0;border-bottom:1px solid var(--line);transition:padding .25s}.role:hover{padding-left:12px}.role-date{font:10px var(--mono);letter-spacing:.08em;color:var(--muted);text-transform:uppercase}.role-company{display:block;color:var(--rust);font-size:12px;font-weight:700;margin-top:8px}.role h3{font:700 20px var(--display);letter-spacing:-.03em;margin:0 0 8px}.role p{color:var(--muted);font-size:13px;line-height:1.8;max-width:850px;margin:0}.tags{display:flex;gap:7px;flex-wrap:wrap;margin-top:13px}.tag{padding:5px 9px;background:#e6e5dc;color:#5c655c;font:9px var(--mono);letter-spacing:.04em}
/* Work cards */
.work-toolbar{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:28px}.filters{display:flex;gap:7px;flex-wrap:wrap}.filter{border:1px solid var(--line);background:transparent;color:var(--muted);padding:9px 12px;font:9px var(--mono);letter-spacing:.08em;text-transform:uppercase;cursor:pointer;transition:.2s}.filter.active,.filter:hover{background:var(--dark);color:#fff;border-color:var(--dark)}.work-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:22px}.work-card{background:var(--paper);border:1px solid var(--line);min-width:0;transition:transform .35s,box-shadow .35s}.work-card:hover{transform:translateY(-7px);box-shadow:0 24px 50px #18211c12}.work-card[hidden]{display:none}.work-art{height:270px;position:relative;overflow:hidden;background:#26352d;color:#fff;padding:23px}.work-art .art-top{display:flex;justify-content:space-between;position:relative;z-index:2;font:9px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:#d8e0d5}.art-title{position:absolute;left:25px;bottom:24px;z-index:2;font:500 clamp(28px,3vw,42px)/.98 var(--serif);max-width:75%;letter-spacing:-.04em}.art-title em{color:var(--lime);font-style:italic}.art-analyst{background:linear-gradient(140deg,#18231e,#40594a 70%,#8b9a78)}.art-analyst:before{content:'ANALYST\A STACK';white-space:pre;position:absolute;right:25px;top:45px;font:800 clamp(40px,6vw,74px)/.83 var(--display);letter-spacing:-.09em;color:#ffffff17;text-align:right}.art-analyst:after{content:'';position:absolute;width:300px;height:300px;border:1px solid #d6e5c155;border-radius:50%;right:-55px;top:45px;box-shadow:0 0 0 32px #ffffff0a,0 0 0 64px #ffffff08}.art-funnel{background:linear-gradient(135deg,#d7d2c5,#8d9b85 60%,#3c5044);color:var(--dark)}.art-funnel:before{content:'';position:absolute;inset:35px 30px 25px auto;width:44%;background:repeating-linear-gradient(180deg,#23372d 0 24px,transparent 24px 31px);clip-path:polygon(0 0,100% 0,80% 100%,20% 100%);opacity:.78}.art-funnel .art-top{color:#344339}.art-funnel .art-title em{color:#7d3e30}.art-organic{background:linear-gradient(135deg,#26352e,#716e5a 65%,#b7a78e)}.art-organic:before{content:'';position:absolute;right:40px;top:45px;width:190px;height:150px;border:1px solid #ffffff55;transform:skewY(-18deg);box-shadow:15px 15px 0 -1px #ffffff12,30px 30px 0 -1px #ffffff0c}.art-contest{background:linear-gradient(135deg,#713e31,#a66e56 58%,#d2b99b)}.art-contest:before{content:'';position:absolute;right:45px;top:36px;width:155px;height:155px;border-radius:50%;border:1px solid #ffffff70;box-shadow:0 0 0 20px #ffffff12,0 0 0 42px #ffffff0a}.work-body{padding:25px}.work-kicker{font:9px var(--mono);color:var(--rust);letter-spacing:.13em;text-transform:uppercase}.work-body h3{font:700 22px/1.2 var(--display);letter-spacing:-.04em;margin:12px 0}.work-body p{font-size:12px;color:var(--muted);line-height:1.8;margin:0}.work-stats{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);margin-top:22px;padding-top:18px;gap:12px}.work-stat strong{display:block;font:700 23px var(--display);letter-spacing:-.06em;transform-origin:left center}.work-card:hover .work-stat strong{color:#285f3e}.work-stat strong[data-counted="true"]{animation:numberSettle .45s cubic-bezier(.2,1.5,.4,1)}@keyframes numberSettle{from{transform:translateY(7px) scale(.92);opacity:.45}to{transform:translateY(0) scale(1);opacity:1}}.work-stat span{display:block;font-size:9px;color:var(--muted);margin-top:3px}.work-details{display:none}.detail-inner{display:grid;grid-template-columns:1fr 1fr;gap:18px}.detail-inner h4{font:700 10px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--rust);margin:0 0 6px}.detail-inner p{font-size:11px;color:var(--muted);line-height:1.7;margin:0}.expand{border:0;border-top:1px solid var(--line);background:transparent;color:var(--rust);padding:17px 25px 20px;font:10px var(--mono);letter-spacing:.08em;text-transform:uppercase;cursor:pointer;width:100%;text-align:left;display:flex;justify-content:space-between;align-items:center}.expand:hover{background:#e9eee6}.case-modal{position:fixed;inset:0;z-index:500;background:#10251dcc;backdrop-filter:blur(10px);display:none;align-items:center;justify-content:center;padding:24px}.case-modal.open{display:flex;animation:modalFade .25s ease both}.case-modal-panel{width:min(900px,100%);max-height:min(88vh,900px);overflow:auto;background:var(--paper);color:var(--ink);border:1px solid #d5dfd2;box-shadow:0 30px 100px #0005;animation:modalPop .35s cubic-bezier(.2,1.2,.3,1) both}.case-modal-head{padding:25px 30px 22px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:20px;align-items:flex-start}.case-modal-kicker{font:10px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--rust)}.case-modal-head h3{font:500 clamp(30px,5vw,48px)/1.04 var(--serif);letter-spacing:-.04em;margin:12px 0 0}.case-modal-close{border:1px solid var(--line);background:transparent;width:38px;height:38px;cursor:pointer;font-size:20px;flex:none}.case-modal-body{padding:28px 30px 32px}.case-modal-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:28px}.case-modal-metric{background:#e9f0e8;padding:20px;min-height:120px;display:flex;flex-direction:column;justify-content:center}.case-modal-metric strong{font:700 clamp(32px,5vw,54px)/1 var(--display);letter-spacing:-.07em;color:#245d3c}.case-modal-metric span{font:10px var(--mono);text-transform:uppercase;letter-spacing:.08em;color:#596b5d;margin-top:10px}.case-modal-story{display:grid;grid-template-columns:1fr 1fr;gap:28px;border-top:1px solid var(--line);padding-top:23px}.case-modal-story h4{font:700 10px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--rust);margin:0 0 8px}.case-modal-story p{font-size:13px;color:var(--muted);line-height:1.8;margin:0}.case-modal-note{margin-top:20px;font-size:10px;color:#718074}@keyframes modalFade{from{opacity:0}to{opacity:1}}@keyframes modalPop{from{opacity:0;transform:translateY(24px) scale(.97)}to{opacity:1;transform:translateY(0) scale(1)}}
/* Strategy system */
.system-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid #ffffff25;border-left:1px solid #ffffff25}.system-card{padding:26px 23px 30px;border-right:1px solid #ffffff25;border-bottom:1px solid #ffffff25;min-height:220px;position:relative;overflow:hidden;transition:background .3s}.system-card:hover{background:#ffffff0b}.system-card:after{content:'';position:absolute;width:80px;height:80px;border:1px solid #c7e27b45;border-radius:50%;right:-30px;bottom:-30px;transition:transform .4s}.system-card:hover:after{transform:scale(2.1)}.system-num{color:var(--lime);font:10px var(--mono)}.system-card h3{font:600 20px var(--serif);margin:38px 0 10px}.system-card p{color:#b2bbb1;font-size:11px;line-height:1.75;margin:0}
/* Skills */
.cap-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line)}.cap{padding:24px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);min-height:180px;transition:background .25s}.cap:hover{background:#e9e7de}.cap small{font:9px var(--mono);color:var(--rust)}.cap h3{font:700 16px var(--display);margin:27px 0 8px}.cap p{font-size:11px;color:var(--muted);line-height:1.75;margin:0}.tool-list{display:flex;flex-wrap:wrap;gap:8px;margin-top:25px}.tool{border:1px solid var(--line);padding:8px 11px;font:10px var(--mono);color:#606a60;transition:.2s}.tool:hover{background:var(--dark);color:white;border-color:var(--dark)}
/* Education and contact */
.education{display:grid;grid-template-columns:1fr 1fr;gap:25px}.edu{padding:24px;border:1px solid var(--line);background:var(--paper)}.edu-year{font:10px var(--mono);color:var(--rust)}.edu h3{font:700 17px var(--display);margin:16px 0 5px}.edu p{font-size:12px;color:var(--muted);margin:0}.contact{background:var(--lime);padding:95px 0;color:var(--dark);position:relative;overflow:hidden}.contact:after{content:'LET’S\A TALK';white-space:pre;position:absolute;right:3%;bottom:-70px;font:800 clamp(100px,20vw,260px)/.78 var(--display);letter-spacing:-.1em;color:#18211c0b;pointer-events:none}.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:end;position:relative;z-index:1}.contact h2{font:500 clamp(48px,7vw,86px)/.98 var(--serif);letter-spacing:-.06em;margin:20px 0}.contact p{max-width:480px;color:#46523f;font-size:14px}.contact-links{display:flex;gap:10px;flex-wrap:wrap}.contact .btn{background:var(--dark);color:white;border-color:var(--dark)}.contact .btn.ghost{background:transparent;color:var(--dark);border-color:#18211c66}.footer{background:var(--dark);color:#b6c0b4;padding:23px 0}.footer-inner{display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap;font:9px var(--mono);letter-spacing:.08em;text-transform:uppercase}
/* reveal */
